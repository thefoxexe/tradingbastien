# Copier en .env (hors Git) et remplir. Valeurs ci-dessous FACTICES.

# backtest | demo | live
MODE=backtest

# Live uniquement : les deux sont obligatoires, sinon refus de démarrer.
LIVE_CONFIRMED=no
MAX_CAPITAL_USDT=

# Démo : clés du compte Demo Trading (api-demo.bybit.com).
# Live : clé du sous-compte, Contract Trade (Order + Position) seulement,
# liée à l'IP du VPS, saisie à la main sur le VPS.
BYBIT_API_KEY=xxxxxxxxxxxxxxxxxx
BYBIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RECV_WINDOW_MS=5000

SYMBOLS=["BTCUSDT","ETHUSDT"]

POSTGRES_USER=bot
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bot
DATABASE_URL=postgresql+psycopg://bot:change-me@db:5432/bot

TELEGRAM_BOT_TOKEN=000000000:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=000000000

LOG_LEVEL=INFO

# Surveillance externe (healthchecks.io, Uptime Kuma…) : ping chaque minute.
HEARTBEAT_URL=

# Dashboard : n'écoute que sur l'IP Tailscale du VPS (tailscale ip -4).
TAILSCALE_IP=100.64.0.1

# Sauvegardes (scripts/backup.sh)
BACKUP_GPG_RECIPIENT=
BACKUP_REMOTE=

# Risque : ne peut qu'ABAISSER les plafonds codés en dur (sinon refus de démarrer).
RISK_PER_TRADE=0.01
MAX_EFFECTIVE_LEVERAGE=2
MAX_OPEN_POSITIONS=2
MAX_TOTAL_OPEN_RISK=0.02
FEE_TAKER=0.00055
